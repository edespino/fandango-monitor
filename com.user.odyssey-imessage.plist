<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.odyssey-imessage</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPO_PATH/imessage_watch.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <!-- Reads the published status page only, never Fandango. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPO_PATH/imessage.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/imessage.err.log</string>
</dict>
</plist>
